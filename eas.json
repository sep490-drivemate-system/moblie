{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "android": {
        "autoIncrement": true
      }
    },
    "apk": {
      "android": {
        "buildType": "apk",
        "developmentClient": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}